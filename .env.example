# Copy this file to .env and fill in values. .env is git-ignored. Never commit it.

# Hugging Face READ-ONLY token (https://huggingface.co/settings/tokens -> "Read").
# Needed once to download the pyannote diarization model after accepting its terms.
HF_TOKEN=

# Disable pyannote telemetry. Always 0.
PYANNOTE_METRICS_ENABLED=0

# After models are downloaded, the app forces offline mode (HF_HUB_OFFLINE=1) at runtime.
